# Local secrets for deploy/compose.yaml. `just setup` creates deploy/.env with
# random values; this file only documents the keys. Never commit deploy/.env.

# Password of the `kage` role in the bundled Postgres. It becomes part of
# KAGE__DATABASE__URL, so it must be safe inside a URL (hex is).
KAGE_POSTGRES_PASSWORD=

# Shared secret between kage and the browser sidecars
# (KAGE__SIDECAR__TOKEN, sent as X-Kage-Sidecar-Token).
KAGE_SIDECAR_TOKEN=

# Key that encrypts proxy credentials at rest (KAGE__SECRETS__MASTER_KEY):
# 32 random bytes, hex-encoded. Losing it makes stored credentials unreadable.
KAGE_MASTER_KEY=

# Optional: the Webshare API key (KAGE__WEBSHARE__API_KEY). With it kage keeps
# its proxy pool in step with the Webshare account; without a proxy provider
# the pool stays empty. See docs/runbooks/proxies.md.
# KAGE_WEBSHARE_API_KEY=

# Optional: an AbuseIPDB key (KAGE__REPUTATION__ABUSEIPDB_KEY) switches the
# daily IP reputation checks on.
# KAGE_ABUSEIPDB_KEY=

# Optional, only with the compose profile `echo` (the fingerprint echo,
# docs/runbooks/fingerprint-echo.md): the directory with its cert.pem and
# key.pem, and where it is published. The proxies' exits must reach it.
# KAGE_ECHO_TLS_DIR=./echo-tls
# KAGE_ECHO_PUBLISH_ADDR=0.0.0.0
# KAGE_ECHO_PUBLISH_PORT=8443

# Optional: where kage is published on the host. Loopback by default, because
# the API has no authentication until M8.
# KAGE_PUBLISH_ADDR=127.0.0.1
# KAGE_PUBLISH_PORT=8080
