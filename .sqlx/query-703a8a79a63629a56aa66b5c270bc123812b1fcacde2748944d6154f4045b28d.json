  "query": "SELECT domain,\n                      SUM(bytes_up)::bigint AS \"up!\",\n                      SUM(bytes_down)::bigint AS \"down!\"\n               FROM bandwidth_usage WHERE hour >= $1\n               GROUP BY domain\n               ORDER BY SUM(bytes_up) + SUM(bytes_down) DESC, domain\n               LIMIT $2",
