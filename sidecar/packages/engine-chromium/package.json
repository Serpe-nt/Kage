{
  "name": "@kage/engine-chromium",
  "version": "0.1.0",
  "private": true,
  "description": "Chromium engine: patchright driving real Chrome. Owns its own playwright pin.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kage/engine-core": "workspace:*",
    "patchright": "1.63.0"
  }
}
