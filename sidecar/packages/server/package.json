{
  "name": "@kage/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify server of the browser sidecar; the ENGINE variable selects the engine package.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@kage/contract": "workspace:*",
    "@kage/engine-chromium": "workspace:*",
    "@kage/engine-core": "workspace:*",
    "@kage/engine-firefox": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "@prometheus-io/client": "0.16.1",
    "fastify": "5.12.6",
    "pino": "10.4.0",
    "zod": "4.6.6"
  }
}
