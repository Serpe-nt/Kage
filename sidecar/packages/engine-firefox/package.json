{
  "name": "@kage/engine-firefox",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox engine: camoufox-js driving Camoufox. Owns its own playwright-core pin.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kage/engine-core": "workspace:*",
    "camoufox-js": "0.12.1",
    "playwright-core": "1.62.1"
  }
}
